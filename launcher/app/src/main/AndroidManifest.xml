<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.NFC" />
    <permission android:name="com.josemontes.launcher.permission.PANEL" android:protectionLevel="signature" />
    <uses-permission android:name="com.josemontes.launcher.permission.PANEL" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <package android:name="com.josemontes.panel" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.fede.launcher.THEME_ICONPACK" /></intent>
        <intent><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent>
    </queries>
    <application
        android:label="Meraki Launcher"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Tema"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".ReceptorMusica"
            android:exported="true"
            android:permission="com.josemontes.launcher.permission.PANEL">
            <intent-filter>
                <action android:name="com.josemontes.launcher.MUSICA" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ReceptorModo"
            android:exported="true"
            android:permission="com.josemontes.launcher.permission.PANEL">
            <intent-filter>
                <action android:name="com.josemontes.launcher.MODO" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".Proveedor"
            android:authorities="com.josemontes.launcher.panel"
            android:exported="true"
            android:permission="com.josemontes.launcher.permission.PANEL" />
        <receiver
            android:name=".Admin"
            android:label="Meraki Launcher · apagar pantalla"
            android:description="@string/admin_desc"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".Tiles$PanelMeraki"
            android:label="Panel Meraki"
            android:icon="@drawable/ic_t_panel"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".Tiles$Apagar"
            android:label="Apagar pantalla"
            android:icon="@drawable/ic_t_apagar"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".Tiles$App1"
            android:label="Meraki · App 1"
            android:icon="@drawable/ic_t_app"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".Tiles$App2"
            android:label="Meraki · App 2"
            android:icon="@drawable/ic_t_app"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".Tiles$App3"
            android:label="Meraki · App 3"
            android:icon="@drawable/ic_t_app"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
    </application>
</manifest>
